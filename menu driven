def sq():
    s=int(input("Enter side: "))
    print("Area:",s*s)
def rec(l,b):
    print("Area:",l*b)
def cir():
    r=int(input("Enter radius:"))
    return 3.14*r*r
def tri(b,h):
    return 0.5*b*h
while True:
